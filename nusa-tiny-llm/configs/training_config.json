{
  "objective": "causal_lm",
  "batch_size": 64,
  "gradient_accumulation_steps": 8,
  "learning_rate": 0.0003,
  "weight_decay": 0.1,
  "warmup_steps": 1000,
  "max_steps": 100000,
  "precision": "bf16",
  "precision_fallback": "fp32",
  "gradient_clipping": 1.0,
  "checkpoint_every_steps": 1000,
  "logging_every_steps": 10,
  "seed": 1337,
  "optimizer": "adamw",
  "beta1": 0.9,
  "beta2": 0.95,
  "eps": 1e-08,
  "scheduler_type": "cosine_with_warmup",
  "min_lr_ratio": 0.1,
  "eval_every_steps": 500,
  "save_total_limit": 3,
  "shuffle_buffer_size": 10000,
  "num_workers": 4,
  "pin_memory": true,
  "mixed_precision": true,
  "activation_checkpointing": false,
  "use_flash_attention": false,
  "max_sequence_length": 1024,
  "pad_to_multiple_of": 64,
  "label_smoothing": 0.0,
  "description": "Training configuration for Nusa Tiny LLM - requires GPU/Colab/server"
}
