{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nusa Tiny LLM Data Sample",
  "type": "object",
  "required": ["id", "lang", "type", "prompt", "response", "quality", "created_at", "source_provider"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier (UUID)"
    },
    "lang": {
      "type": "string",
      "enum": ["en", "id"],
      "description": "Language code"
    },
    "type": {
      "type": "string",
      "enum": ["translation", "qa", "instruction", "conversation", "reasoning", "safety"],
      "description": "Data type category"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "Input prompt or question"
    },
    "response": {
      "type": "string",
      "minLength": 1,
      "description": "Expected response or answer"
    },
    "quality": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Quality score (0=low, 5=high)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "source_provider": {
      "type": "string",
      "enum": ["mock", "local_cli", "openai_compatible", "custom"],
      "description": "Data source provider"
    }
  },
  "additionalProperties": false
}
